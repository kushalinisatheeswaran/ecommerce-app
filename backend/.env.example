# Environment Variable Documentation for Spring Boot Backend on Render / Cloud Host
# Do NOT put real secrets in this file.

# Server Port (Render dynamically assigns PORT)
PORT=8081

# Cloud PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:PORT/DATABASE
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

# JWT Secret Key (256-bit key for signing tokens - enter in Render Env Vars)
JWT_SECRET=YOUR_SECURE_PRODUCTION_JWT_SECRET

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,https://ecommerce-app-wine-six.vercel.app
